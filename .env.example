# Runtime connection used by the NestJS application.
# On Render, prefer Supabase's session pooler URL when direct IPv6 is unavailable.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional overrides for the local PostgreSQL container started by `pnpm infra`.
LOCAL_POSTGRES_DB=cardpilot
LOCAL_POSTGRES_USER=cardpilot
LOCAL_POSTGRES_PASSWORD=cardpilot
LOCAL_POSTGRES_PORT=5432

# Optional overrides for the OCR container started by `pnpm dev:ocr`.
LOCAL_OCR_PORT=8080
OCR_DOWNLOAD_MODELS=1
OCR_DEVICE=cpu
OCR_DEFAULT_CURRENCY=VND
OCR_MODEL_DIR=models

# To run NestJS against local PostgreSQL, use this as DATABASE_URL:
# postgresql://cardpilot:cardpilot@localhost:5432/cardpilot

# Direct Supabase connection used only by TypeORM migration commands.
DIRECT_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

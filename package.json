{
  "name": "cardpilot-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "nx": "nx",
    "dev": "tsx tools/dev-picker/index.ts",
    "dev:all": "NX_TUI=true nx run-many -t serve,run -p cardpilot-backend,cardpilot-app,cardpilot-ocr-service --parallel",
    "dev:backend": "NX_TUI=true nx run cardpilot-backend:serve",
    "dev:mobile": "NX_TUI=true nx run cardpilot-app:run",
    "dev:ocr": "NX_TUI=true nx run cardpilot-ocr-service:serve",
    "infra": "docker compose up -d --wait --pull missing postgres",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres",
    "format": "nx format:write",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "serve:backend": "nx serve cardpilot-backend",
    "serve:api": "nx serve cardpilot-backend",
    "ocr:setup": "nx run cardpilot-ocr-service:setup",
    "ocr:test": "nx run cardpilot-ocr-service:test",
    "ocr:build": "nx run cardpilot-ocr-service:build",
    "ocr:stop": "nx run cardpilot-ocr-service:stop",
    "ocr:logs": "nx run cardpilot-ocr-service:logs",
    "ocr:research:prepare": "nx run cardpilot-ocr-research:prepare",
    "ocr:research:benchmark": "nx run cardpilot-ocr-research:benchmark",
    "ocr:research:export": "nx run cardpilot-ocr-research:export",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:show": "pnpm typeorm migration:show -d apps/cardpilot-backend/src/database/data-source.ts",
    "migration:run": "pnpm typeorm migration:run -d apps/cardpilot-backend/src/database/data-source.ts",
    "migration:create": "sh -c 'typeorm migration:create apps/cardpilot-backend/src/database/migrations/$1' --",
    "migration:revert": "pnpm typeorm migration:revert -d apps/cardpilot-backend/src/database/data-source.ts",
    "run:mobile": "nx run cardpilot-app:run",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.7.1",
    "@nx/eslint-plugin": "22.7.1",
    "@nx/jest": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/nest": "^22.7.1",
    "@nx/node": "22.7.1",
    "@nx/web": "22.7.1",
    "@nx/webpack": "22.7.1",
    "@nxrocks/nx-flutter": "^10.0.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/blessed": "^0.1.27",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^5.6.2",
    "enquirer": "^2.4.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "^22.7.1",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "typeorm": "^1.1.0"
  }
}
